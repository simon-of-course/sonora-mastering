    <font name="sonora.title" font-name="Segoe UI" size="12" bold="true" alternative-font-names="Arial, Helvetica, DejaVu Sans"/>
    <font name="sonora.big" font-name="Segoe UI" size="20" bold="true" alternative-font-names="Arial, Helvetica, DejaVu Sans"/>
    <font name="sonora.huge" font-name="Segoe UI" size="30" bold="true" alternative-font-names="Arial, Helvetica, DejaVu Sans"/>
  </fonts>
